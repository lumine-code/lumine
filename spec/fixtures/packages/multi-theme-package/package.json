{
  "name": "multi-theme-package",
  "version": "1.0.0",
  "themes": [
    {
      "name": "multi-alpha-ui",
      "theme": "ui",
      "extends": [
        "multi-theme-base-package::styles/base/base.css",
        "multi-theme-base-package::styles/base/{inherited,variables}.css"
      ],
      "styles": "styles/alpha"
    },
    {
      "name": "multi-alpha-syntax",
      "theme": "syntax",
      "extends": "multi-theme-base-package::styles/base/inherited.css",
      "styles": "styles/alpha-syntax"
    }
  ],
  "themePacks": [
    {
      "name": "Multi Alpha",
      "light": [
        "multi-alpha-ui",
        "multi-alpha-syntax"
      ],
      "dark": [
        "multi-alpha-ui",
        "multi-alpha-syntax"
      ]
    }
  ]
}
