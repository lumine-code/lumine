{
  "name": "Test Python",
  "type": "tree-sitter",
  "scopeName": "test.py",
  "parser": "tree-sitter-python",
  "firstLineRegex": "^\\#!.*(?:\\s|\\/)(?:testpython)(?:$|\\s)",
  "fileTypes": [
    "py"
  ],
  "treeSitter": {
    "highlightsQuery": "./tree-sitter-empty.scm",
    "grammar": "./tree-sitter-empty.wasm"
  }
}
