{
  "name": "Clojure EDN",
  "scopeName": "source.edn",
  "type": "modern-tree-sitter",
  "injectionRegExp": "^source-clojure-edn$",
  "parser": "tree-sitter-clojure",
  "fileTypes": [],
  "treeSitter": {
    "parserSource": "github:mauricioszabo/tree-sitter-clojure#59051aa9c4344d9f8d81264b423b7fd5199cc2d6",
    "wasmBuildTool": "tree-sitter-cli#v0.26.11",
    "grammar": "ts/grammar.wasm",
