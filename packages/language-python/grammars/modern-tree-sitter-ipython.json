{
  "name": "IPython",
  "scopeName": "source.python.ipy",
  "type": "modern-tree-sitter",
  "parser": "tree-sitter-python",
  "injectionRegex": "^(ipy|IPY|ipython|IPython|IPYTHON)$",
  "fileTypes": ["ipy"],
  "treeSitter": {
    // The lumine-code fork extends upstream v0.25.0 with IPython-only
    // statements (magic_statement, shell_statement, help_statement) so .ipy
    // sources parse without ERROR nodes. Plain .py files stay on the pure
    // upstream parser above.
    "parserSource": "github:lumine-code/tree-sitter-python#4f29d4375ee1977a53b2bed87540a62598e88200",
    "wasmBuildTool": "tree-sitter-cli#v0.26.11",
    "grammar": "ts/tree-sitter-ipython.wasm",
    "highlightsQuery": ["ts/highlights.scm", "ts/ipython-highlights.scm"],
    "tagsQuery": "ts/tags.scm",
    "foldsQuery": "ts/folds.scm",
    "indentsQuery": "ts/indents.scm"
  }
}
