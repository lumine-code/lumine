{
  "scopeName": "source.python.ipy",
  "name": "IPython",
  "fileTypes": ["ipy"],
  "firstLineMatch": "^#![ \\t]*/.*\\bipython[\\d\\.]*\\b",
  "patterns": [
    {
      // Line and cell magics: %matplotlib inline, %%timeit. The name char
      // after the sigil keeps continuation lines like `% b` untouched.
      "match": "^\\s*%%?[A-Za-z_].*$",
      "name": "support.function.magic.ipython"
    },
    {
      // Shell escapes: !pip install numpy, !!ls. The lookahead keeps
      // break-before-operator continuation lines like `!= b` untouched.
      "match": "^\\s*!(?!=).*$",
      "name": "string.unquoted.shell.ipython"
    },
    {
      // Help requests, prefix form: ?obj, ??obj.
      "match": "^\\s*\\?\\??.*$",
      "name": "keyword.operator.help.ipython"
    },
    {
      // Help requests, suffix form: obj?, np.mean?? (must fill the line).
      "match": "^\\s*[A-Za-z_][A-Za-z0-9_.]*\\?\\??\\s*$",
      "name": "keyword.operator.help.ipython"
    },
    {
      "include": "source.python"
    }
  ]
}
