    "indicator",
    "vcs"
  ],
  "license": "MIT",
  "repository": "https://github.com/lumine-code/lumine",
  "engines": {
    "atom": "*"
  },
  "dependencies": {
    "@lumine-code/select-list": "https://github.com/lumine-code/select-list.git#a201dae6a0ea6954cb9a905be4a718af697d9f78"
  },
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    }
  }
}
