{
  "name": "git-center",
  "author": "lumine-code",
  "version": "1.0.0",
  "main": "./lib/main",
  "description": "Show the active Git repository, branch, and working-tree status in the status bar.",
  "keywords": [
    "branch",
    "repository",
    "checkout",
    "upstream",
