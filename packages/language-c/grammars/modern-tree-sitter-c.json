{
  "name": "C",
  "scopeName": "source.c",
  "type": "modern-tree-sitter",
  "parser": "tree-sitter-c",
  "firstLineRegex": "-\\*-[^*]*(Mode:\\s*)?C(\\s*;.*?)?\\s*-\\*-",
  "injectionRegex": "^(c|C)$",
  "treeSitter": {
    "parserSource": "github:tree-sitter/tree-sitter-c#v0.24.2",
    "wasmBuildTool": "tree-sitter-cli#v0.26.11",
    "grammar": "tree-sitter-c/tree-sitter-c.wasm",
    "languageSegment": "c",
    "highlightsQuery": ["common/highlights.scm", "tree-sitter-c/highlights.scm"],
    "tagsQuery": "tree-sitter-c/tags.scm",
    "foldsQuery": "tree-sitter-c/folds.scm",
    "indentsQuery": "tree-sitter-c/indents.scm"
  },
  "fileTypes": ["h", "c", "h.in"],
  "comments": {
    "start": "// "
  }
}
