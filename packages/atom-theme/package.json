{
  "name": "atom-theme",
  "author": "lumine-code",
  "themes": [
    {
      "name": "atom-day-ui",
      "theme": "ui",
      "styles": [
        "styles/ui",
        "styles/day-ui"
      ]
    },
    {
      "name": "atom-day-syntax",
      "theme": "syntax",
      "styles": "styles/day-syntax"
    },
    {
      "name": "atom-night-ui",
      "theme": "ui",
      "styles": [
        "styles/ui",
        "styles/night-ui"
      ]
    },
    {
      "name": "atom-night-syntax",
      "theme": "syntax",
      "styles": "styles/night-syntax"
    }
  ],
  "themePacks": [
    {
      "name": "Atom",
      "light": [
        "atom-day-ui",
        "atom-day-syntax"
      ],
      "dark": [
        "atom-night-ui",
        "atom-night-syntax"
      ]
    }
  ],
  "version": "1.0.0",
  "description": "The classic Atom day and night UI and syntax themes.",
  "keywords": [
    "classic",
    "retro",
    "day-night",
    "syntax",
    "angled-tabs",
    "light",
    "dark"
  ],
  "repository": "https://github.com/lumine-code/lumine",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  }
}
