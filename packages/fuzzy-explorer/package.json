{
  "name": "fuzzy-explorer",
  "author": "lumine-code",
  "description": "Fuzzy search files across user-defined directories.",
  "keywords": [
    "finder",
    "search",
    "directory",
    "navigation",
    "quick-open"
  ],
  "repository": "https://github.com/lumine-code/lumine",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "backgroundTips": [
    "You can search files across your own list of directories with {{ 'fuzzy-explorer:toggle' | keystroke }}"
  ],
  "main": "./lib/main",
  "activationCommands": {
    "atom-workspace": [
      "fuzzy-explorer:toggle",
      "fuzzy-explorer:refresh",
      "fuzzy-explorer:edit"
    ]
  },
  "consumedServices": {
    "open-external": {
      "versions": {
        "^1.0.0": "consumeOpenExternal"
      }
    },
    "claude-chat": {
      "versions": {
        "^1.0.0": "consumeClaudeChat"
      }
    }
  },
  "configSchema": {
    "ignoredNames": {
      "title": "Ignored Names",
      "description": "List of glob patterns. Files matching these patterns will be ignored.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "separator": {
      "title": "Type of separator in file paths",
      "description": "Type of separator for the file path when copying or pasting.",
      "type": "integer",
      "enum": [
        {
          "value": 0,
          "description": "Default"
        },
        {
          "value": 1,
          "description": "Forward Slash"
        },
        {
          "value": 2,
          "description": "Backslash"
        }
      ],
      "default": 0
    }
  },
  "dependencies": {
    "@lumine-code/season": "https://github.com/lumine-code/season.git#ec9adb297202dd01a425113a4edc2c189d82c14e"
  },
  "devDependencies": {
    "@lumine-code/temp": "https://github.com/lumine-code/node-temp.git#929dfd04196566b21baef93fddc24a19db329bd0"
  }
}
