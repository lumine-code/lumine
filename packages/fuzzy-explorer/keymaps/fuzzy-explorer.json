{
  "atom-workspace": {
    "alt-p": "fuzzy-explorer:toggle"
  },
  // The `alt-v` / `alt-c` chord prefixes have to be declared even though the
  // actions carry their own keystrokes: without a binding for the prefix
  // itself, the first keystroke of a chord resolves as a complete binding.
  "atom-modal[data-modal-view=\"fuzzy-explorer.paths\"]": {
    "alt-v alt-r": "modals:insert-relative-path",
    "alt-c alt-r": "modals:copy-relative-path"
  }
}
