{
  "name": "fuzzy-files",
  "author": "lumine-code",
  "description": "Quickly find and take an action over project files.",
  "keywords": [
    "finder",
    "quick-open",
    "search",
    "navigation",
    "project"
  ],
  "repository": "https://github.com/lumine-code/lumine",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "atom": "*"
  },
  "main": "./lib/main",
  "activationCommands": {
    "atom-workspace": [
      "fuzzy-files:toggle",
      "fuzzy-files:refresh"
    ]
  },
  "providedServices": {
    "fuzzy-files.score-modifier": {
      "versions": {
        "1.0.0": "provideFuzzyFilesScoreModifier"
      }
    }
  },
  "consumedServices": {
    "open-external": {
      "versions": {
        "^1.0.0": "consumeOpenExternal"
      }
    },
    "windows-clip": {
      "versions": {
        "^1.0.0": "consumeWindowsClip"
      }
    },
    "claude-chat": {
      "versions": {
        "^1.0.0": "consumeClaudeChat"
      }
    },
    "tree-view.selection": {
      "versions": {
        "^1.0.0": "consumeTreeViewSelection"
      }
    }
  },
  "dependencies": {
    "picomatch": "^4.0.5",
    "@lumine-code/select-list": "https://github.com/lumine-code/select-list.git#c598adc39d2c3167b3519226859842dca4f9d026"
  },
  "configSchema": {
    "ignoredNames": {
      "order": 1,
      "title": "List of ignore glob patterns",
      "description": "Files and directories matching these patterns are ignored. This list is merged with the list defined by the core `Ignored Names' configuration setting.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "separator": {
      "order": 2,
      "title": "Type of separator in file paths",
      "description": "Type of separator for the file path when copying or pasting.",
      "type": "integer",
      "enum": [
        {
          "value": 0,
          "description": "Default"
        },
        {
          "value": 1,
          "description": "Forward Slash"
        },
        {
          "value": 2,
          "description": "Backslash"
        }
      ],
      "default": 0
    }
  }
}
