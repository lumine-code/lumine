{
  "atom-workspace": {
    "ctrl-p": "fuzzy-files:toggle"
  },
  ".fuzzy-files atom-text-editor[mini]": {
    "alt-enter": "fuzzy-files:open-external",
    "ctrl-enter": "fuzzy-files:show-in-folder",
    "alt-delete": "fuzzy-files:trash",
    "alt-left": "fuzzy-files:split-left",
    "alt-right": "fuzzy-files:split-right",
    "alt-up": "fuzzy-files:split-up",
    "alt-down": "fuzzy-files:split-down",
    "alt-v alt-p": "fuzzy-files:insert-project-path",
    "alt-v alt-a": "fuzzy-files:insert-absolute-path",
    "alt-v": "fuzzy-files:insert-relative-path",
    "alt-v alt-r": "fuzzy-files:insert-relative-path",
    "alt-v alt-n": "fuzzy-files:insert-file-name",
    "alt-c alt-p": "fuzzy-files:copy-project-path",
    "alt-c alt-a": "fuzzy-files:copy-absolute-path",
    "alt-c": "fuzzy-files:copy-relative-path",
    "alt-c alt-r": "fuzzy-files:copy-relative-path",
    "alt-c alt-n": "fuzzy-files:copy-file-name",
    "alt-0": "fuzzy-files:use-default-separator",
    "alt-/": "fuzzy-files:use-forward-slashes",
    "alt-\\": "fuzzy-files:use-backslashes",
    "alt-q": "fuzzy-files:query-selected-path",
    "alt-s": "fuzzy-files:query-selection",
    "alt-t": "fuzzy-files:reveal-in-tree-view",
    "alt-f": "fuzzy-files:claude-chat",
    "f5": "fuzzy-files:refresh-index",
    "alt-w alt-x": "fuzzy-files:cut-file",
    "alt-w alt-c": "fuzzy-files:copy-file"
  }
}
