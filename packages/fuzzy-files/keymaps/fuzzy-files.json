{
  "atom-workspace": {
    "ctrl-p": "fuzzy-files:toggle"
  },
  // The chord aliases have to be declared even though the actions carry their
  // own keystrokes: without a binding for the full chord, the `alt-v` /
  // `alt-c` prefix resolves as a complete binding on its own.
  "atom-modal[data-modal-view=\"fuzzy-files.paths\"]": {
    "alt-v alt-r": "modals:insert-relative-path",
    "alt-c alt-r": "modals:copy-relative-path"
  }
}
