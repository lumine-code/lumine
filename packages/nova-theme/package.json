{
  "name": "nova-theme",
  "author": "lumine-code",
  "main": "lib/main",
  "themes": [
    {
      "name": "nova-day-ui",
      "theme": "ui",
      "extends": "one-theme::styles/ui/*",
      "styles": [
        "styles/ui-overrides",
        "styles/day-ui"
      ]
    },
    {
      "name": "nova-day-syntax",
      "theme": "syntax",
      "extends": "one-theme::styles/day-syntax/*",
      "styles": [
        "styles/syntax-overrides",
        "styles/day-syntax"
      ]
    },
    {
      "name": "nova-night-ui",
      "theme": "ui",
      "extends": "one-theme::styles/ui/*",
      "styles": [
        "styles/ui-overrides",
        "styles/night-ui"
      ]
    },
    {
      "name": "nova-night-syntax",
      "theme": "syntax",
      "extends": "one-theme::styles/night-syntax/*",
      "styles": [
        "styles/syntax-overrides",
        "styles/night-syntax"
      ]
    }
  ],
  "version": "1.0.0",
  "description": "The Nova day and night UI and syntax themes.",
  "keywords": [
    "light",
    "dark",
    "syntax",
    "day-night",
    "color-scheme",
    "violet"
  ],
  "repository": "https://github.com/lumine-code/lumine",
  "license": "MIT",
  "engines": {
    "atom": "*"
  }
}
