{
  "name": "archive-view",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Browse the files and folders inside archive files.",
  "keywords": [
    "zip",
    "tar",
    "jar",
    "epub",
    "extract",
    "compressed"
  ],
  "main": "./lib/archive-editor",
  "dependencies": {
    "@lumine-code/etch": "https://github.com/lumine-code/etch.git#ace74599f9d6b54e9eb24ecb1e2407e9c35fcc74",
    "@lumine-code/ls-archive": "https://github.com/lumine-code/node-ls-archive.git#f897b86effcc50a6a1a41f04cdc3f4d6f288212d",
    "humanize-plus": "~1.8.2",
    "@lumine-code/temp": "https://github.com/lumine-code/node-temp.git#929dfd04196566b21baef93fddc24a19db329bd0"
  },
  "repository": "https://github.com/lumine-code/lumine",
  "license": "MIT",
  "engines": {
    "atom": "*"
  },
  "deserializers": {
    "ArchiveEditor": "deserialize",
    "ArchiveEditorView": "deserialize"
  },
  "consumedServices": {
    "icons.class": {
      "versions": {
        "^1.0.0": "consumeIconsClass"
      }
    },
    "icons.element": {
      "versions": {
        "^1.0.0": "consumeIconsElement"
      }
    }
  }
}
