{
  "atom-workspace": {
    "f10": "project-list:toggle",
    "ctrl-f10": "project-list:edit"
  },
  ".project-list atom-text-editor[mini]": {
    "alt-enter": "project-list:swap",
    "ctrl-enter": "project-list:switch",
    "shift-enter": "project-list:append",
    "alt-v": "project-list:paste",
    "alt-d": "project-list:dev",
    "alt-s": "project-list:safe",
    "alt-f12": "project-list:external",
    "ctrl-f12": "project-list:show",
    "f5": "project-list:refresh"
  }
}
