{
  "name": "aura-theme",
  "author": "lumine-code",
  "themes": [
    {
      "name": "aura-day-ui",
      "theme": "ui",
      "extends": [
        "one-theme::styles/ui/*",
        "one-theme::styles/day-ui/*"
      ],
      "styles": [
        "styles/ui-overrides",
        "styles/day-ui"
      ]
    },
    {
      "name": "aura-day-syntax",
      "theme": "syntax",
      "extends": "one-theme::styles/day-syntax/*",
      "styles": "styles/day-syntax"
    },
    {
      "name": "aura-night-ui",
      "theme": "ui",
      "extends": [
        "one-theme::styles/ui/*",
        "one-theme::styles/night-ui/*"
      ],
      "styles": [
        "styles/ui-overrides",
        "styles/night-ui"
      ]
    },
    {
      "name": "aura-night-syntax",
      "theme": "syntax",
      "extends": "one-theme::styles/night-syntax/*",
      "styles": "styles/night-syntax"
    }
  ],
  "themePacks": [
    {
      "name": "Aura",
      "light": [
        "aura-day-ui",
        "aura-day-syntax"
      ],
      "dark": [
        "aura-night-ui",
        "aura-night-syntax"
      ]
    }
  ],
  "version": "1.0.0",
  "description": "A modern, brighter day and deeper night take on the One UI and syntax themes.",
  "keywords": [
    "modern",
    "light",
    "dark",
    "syntax",
    "day-night",
    "minimal"
  ],
  "repository": "https://github.com/lumine-code/lumine",
  "license": "MIT",
  "engines": {
    "atom": "*"
  }
}
