{
  "name": "ide-client",
  "author": "lumine-code",
  "version": "1.0.0",
  "main": "./lib/main",
  "types": "./lib/main.d.ts",
  "description": "Language Server Protocol client infrastructure.",
  "keywords": [
    "lsp",
    "language-server",
    "intellisense",
    "diagnostics",
    "completion"
  ],
  "repository": "https://github.com/lumine-code/lumine",
  "license": "MIT",
  "engines": {
    "atom": "*",
    "node": ">=24"
  },
  "dependencies": {
    "@lumine-code/select-list": "https://github.com/lumine-code/select-list.git#a201dae6a0ea6954cb9a905be4a718af697d9f78",
    "picomatch": "^4.0.5"
  },
  "providedServices": {
    "ide-client": {
      "versions": {
        "1.0.0": "provideIdeClient"
      }
    },
    "autocomplete.provider": {
      "versions": {
        "1.0.0": "provideAutocomplete"
      }
    },
    "symbol.provider": {
      "versions": {
        "1.0.0": "provideSymbol"
      }
    },
    "hover.provider": {
      "versions": {
        "1.0.0": "provideHover"
      }
    },
    "hover.signature-provider": {
      "versions": {
        "1.0.0": "provideHoverSignature"
      }
    },
    "outline.provider": {
      "versions": {
        "1.0.0": "provideOutline"
      }
    },
    "code-format.range": {
      "versions": {
        "1.0.0": "provideCodeFormatRange"
      }
    },
    "code-format.file": {
      "versions": {
        "1.0.0": "provideCodeFormatFile"
      }
    },
    "code-format.on-type": {
      "versions": {
        "1.0.0": "provideCodeFormatOnType"
      }
    },
    "code-format.on-save": {
      "versions": {
        "1.0.0": "provideCodeFormatOnSave"
      }
    },
    "find-references.provider": {
      "versions": {
        "1.0.0": "provideFindReferences"
      }
    },
    "refactor.provider": {
      "versions": {
        "1.0.0": "provideRefactor"
      }
    },
    "intentions.list": {
      "versions": {
        "1.0.0": "provideIntentionsList"
      }
    }
  },
  "consumedServices": {
    "linter.registry": {
      "versions": {
        "^1.0.0": "consumeLinterRegistry"
      }
    },
    "busy-signal": {
      "versions": {
        "^1.0.0": "consumeBusySignal"
      }
    },
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    }
  },
  "configSchema": {
    "trace": {
      "order": 1,
      "title": "Protocol Trace",
      "description": "Log the traffic between the editor and language servers to the per-server log buffer.",
      "type": "string",
      "enum": [
        "off",
        "messages",
        "verbose"
      ],
      "default": "off"
    },
    "restartLimit": {
      "order": 2,
      "title": "Maximum Automatic Restarts",
      "description": "How many times a crashed language server is restarted automatically before giving up.",
      "type": "integer",
      "minimum": 0,
      "default": 3
    },
    "codeLens": {
      "order": 3,
      "title": "Code Lens",
      "description": "Actionable command links rendered above the symbols they describe.",
      "type": "object",
      "properties": {
        "enabled": {
          "order": 1,
          "title": "Enabled",
          "description": "Show code lens links above symbols. Also settable per language in scoped settings.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "semanticTokens": {
      "order": 4,
      "title": "Semantic Tokens",
      "description": "Server-computed highlighting layered over the grammar's own.",
      "type": "object",
      "properties": {
        "enabled": {
          "order": 1,
          "title": "Enabled",
          "description": "Color identifiers with the language server's semantic classification. Also settable per language in scoped settings.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "inlayHints": {
      "order": 5,
      "title": "Inlay Hints",
      "description": "Inline type and parameter-name labels rendered between characters.",
      "type": "object",
      "properties": {
        "enabled": {
          "order": 1,
          "title": "Enabled",
          "description": "Show inlay hints in the visible part of the editor. Also settable per language in scoped settings.",
          "type": "boolean",
          "default": true
        },
        "maxLabelLength": {
          "order": 2,
          "title": "Maximum Label Length",
          "description": "Longer hint labels are truncated with an ellipsis.",
          "type": "integer",
          "minimum": 1,
          "default": 48
        }
      }
    },
    "statusBar": {
      "order": 6,
      "title": "Status Bar",
      "description": "Indicator for the language servers this window is running.",
      "type": "object",
      "properties": {
        "enabled": {
          "order": 1,
          "title": "Enabled",
          "description": "Show the running language servers in the status bar. The item stays in place while none is running, reporting zero.",
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
