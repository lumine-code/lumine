{
  "name": "ide-client",
  "author": "lumine-code",
  "version": "1.0.0",
  "main": "./lib/main",
  "types": "./lib/main.d.ts",
  "description": "Language Server Protocol client infrastructure.",
  "keywords": [
    "lsp",
    "language-server",
    "intellisense",
    "diagnostics",
    "completion"
  ],
  "repository": "https://github.com/lumine-code/lumine",
  "license": "MIT",
  "engines": {
    "atom": "*",
    "node": ">=24"
  },
  "dependencies": {
    "@lumine-code/select-list": "https://github.com/lumine-code/select-list.git#fbbc2d9660db6a2ff676c7a3baf7536f96ec34e6",
    "minimatch": "^10.2.5"
  },
  "providedServices": {
    "lumine.languageServer": {
      "versions": {
        "1.0.0": "provideLanguageServer"
      }
    },
    "autocomplete.provider": {
      "versions": {
        "1.0.0": "provideAutocomplete"
      }
    },
    "symbol.provider": {
      "versions": {
        "1.0.0": "provideSymbols"
      }
    },
    "hover": {
      "versions": {
        "1.0.0": "provideHover"
      }
    },
    "signature": {
      "versions": {
        "1.0.0": "provideSignature"
      }
    },
    "outline-view": {
      "versions": {
        "1.0.0": "provideOutline"
      }
    },
    "code-format.range": {
      "versions": {
        "1.0.0": "provideCodeFormatRange"
      }
    },
    "code-format.file": {
      "versions": {
        "1.0.0": "provideCodeFormatFile"
      }
    },
    "code-format.onType": {
      "versions": {
        "1.0.0": "provideCodeFormatOnType"
      }
    },
    "code-format.onSave": {
      "versions": {
        "1.0.0": "provideCodeFormatOnSave"
      }
    },
    "find-references": {
      "versions": {
        "1.0.0": "provideFindReferences"
      }
    },
    "refactor": {
      "versions": {
        "1.0.0": "provideRefactor"
      }
    },
    "intentions.list": {
      "versions": {
        "1.0.0": "provideIntentions"
      }
    }
  },
  "consumedServices": {
    "linter-indie": {
      "versions": {
        "^1.0.0": "consumeIndie"
      }
    },
    "busy-signal": {
      "versions": {
        "^1.0.0": "consumeBusySignal"
      }
    },
    "busy-signal.background": {
      "versions": {
        "^1.0.0": "consumeBackgroundSignal"
      }
    }
  },
  "configSchema": {
    "trace": {
      "order": 1,
      "title": "Protocol Trace",
      "description": "Log the traffic between the editor and language servers to the per-server log buffer.",
      "type": "string",
      "enum": [
        "off",
        "messages",
        "verbose"
      ],
      "default": "off"
    },
    "restartLimit": {
      "order": 2,
      "title": "Maximum Automatic Restarts",
      "description": "How many times a crashed language server is restarted automatically before giving up.",
      "type": "integer",
      "minimum": 0,
      "default": 3
    },
    "codeLens": {
      "order": 3,
      "title": "Code Lens",
      "description": "Actionable command links rendered above the symbols they describe.",
      "type": "object",
      "properties": {
        "enabled": {
          "order": 1,
          "title": "Enabled",
          "description": "Show code lens links above symbols. Also settable per language in scoped settings.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "semanticTokens": {
      "order": 4,
      "title": "Semantic Tokens",
      "description": "Server-computed highlighting layered over the grammar's own.",
      "type": "object",
      "properties": {
        "enabled": {
          "order": 1,
          "title": "Enabled",
          "description": "Color identifiers with the language server's semantic classification. Also settable per language in scoped settings.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "inlayHints": {
      "order": 5,
      "title": "Inlay Hints",
      "description": "Inline type and parameter-name labels rendered between characters.",
      "type": "object",
      "properties": {
        "enabled": {
          "order": 1,
          "title": "Enabled",
          "description": "Show inlay hints in the visible part of the editor. Also settable per language in scoped settings.",
          "type": "boolean",
          "default": true
        },
        "maxLabelLength": {
          "order": 2,
          "title": "Maximum Label Length",
          "description": "Longer hint labels are truncated with an ellipsis.",
          "type": "integer",
          "minimum": 1,
          "default": 48
        }
      }
    }
  }
}
