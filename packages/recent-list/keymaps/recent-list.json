{
  "atom-workspace": {
    "alt-f10": "recent-list:toggle"
  },
  ".recent-list atom-text-editor[mini]": {
    "alt-enter": "recent-list:swap",
    "ctrl-enter": "recent-list:switch",
    "shift-enter": "recent-list:append",
    "alt-v": "recent-list:paste",
    "alt-d": "recent-list:dev",
    "alt-s": "recent-list:safe",
    "alt-f12": "recent-list:external",
    "ctrl-f12": "recent-list:show",
    "f5": "recent-list:update",
    "alt-delete": "recent-list:delete"
  }
}
