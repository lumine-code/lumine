{
  "name": "vscode-theme",
  "author": "lumine-code",
  "themes": [
    {
      "name": "vscode-day-ui",
      "theme": "ui",
      "extends": [
        "one-theme::styles/ui/*"
      ],
      "styles": [
        "styles/ui-overrides",
        "styles/day-ui"
      ]
    },
    {
      "name": "vscode-day-syntax",
      "theme": "syntax",
      "extends": "one-theme::styles/day-syntax/*",
      "styles": [
        "styles/syntax-overrides",
        "styles/day-syntax"
      ]
    },
    {
      "name": "vscode-night-ui",
      "theme": "ui",
      "extends": [
        "one-theme::styles/ui/*"
      ],
      "styles": [
        "styles/ui-overrides",
        "styles/night-ui"
      ]
    },
    {
      "name": "vscode-night-syntax",
      "theme": "syntax",
      "extends": "one-theme::styles/night-syntax/*",
      "styles": [
        "styles/syntax-overrides",
        "styles/night-syntax"
      ]
    }
  ],
  "themePacks": [
    {
      "name": "VS Code Modern",
      "light": [
        "vscode-day-ui",
        "vscode-day-syntax"
      ],
      "dark": [
        "vscode-night-ui",
        "vscode-night-syntax"
      ]
    }
  ],
  "version": "1.0.0",
  "description": "The VSCode day and night UI and syntax themes following the VS Code Modern look.",
  "keywords": [
    "light",
    "dark",
    "syntax",
    "day-night",
    "dark-modern",
    "light-modern"
  ],
  "repository": "https://github.com/lumine-code/lumine",
  "license": "MIT",
  "engines": {
    "atom": "*"
  }
}
