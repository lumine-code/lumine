{
  "name": "about",
  "author": "lumine-code",
  "main": "./lib/main",
  "version": "1.0.0",
  "description": "View useful information about your Lumine installation.",
  "keywords": [
    "version",
    "release-notes",
    "credits",
    "license",
    "installation"
  ],
  "repository": "https://github.com/lumine-code/lumine",
  "license": "MIT",
  "engines": {
    "atom": "*"
  },
  "dependencies": {
    "@lumine-code/etch": "https://github.com/lumine-code/etch.git#5801d1e3dd5078db7b575d55e72c6e85bd0dcf53"
  },
  "configSchema": {
    "showOnStartup": {
      "title": "Show About On Startup",
