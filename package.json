    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "mock-spawn": "^0.2.6",
    "prettier": "^3.9.10",
    "sinon": "22.1.0",
    "yargs": "18.2.0"
  },
  "allowScripts": {
    "github:lumine-code/keyboard-layout#7808a65f72cd228c50c33c77999bc3ddf549e58f": true,
    "github:lumine-code/fs-admin#184a29daac103f2f94495213f6bda24b1f66bcf8": true,
    "github:lumine-code/watcher#56f663d24066fd095c8496708f915be197819b31": true
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.5"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.5"
    },
    "jasmine@7.0.0": {
      "glob": "14.0.4"
    },
    "@electron/asar": {
      "glob@^13.0.2": "14.0.4",
      "minimatch@^10.0.1": "11.0.5"
    },
    "app-builder-lib@27.0.0-alpha.14": {
      "minimatch@^10.2.5": "11.0.5"
    }
  }
}
