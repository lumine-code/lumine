    "electron": "45.3.1",
    "electron-builder": "27.0.0-alpha.14",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "mock-spawn": "^0.2.6",
    "prettier": "^3.10.0",
    "sinon": "22.1.0",
    "yargs": "18.2.0"
  },
  "allowScripts": {
    "github:lumine-code/keyboard-layout#3325ebcfd28606ff3ff7d1f91be3fff5c63862d5": true,
    "github:lumine-code/fs-admin#08fd3ad5960be044e4346658439abf342b44fc33": true,
    "github:lumine-code/watcher#442f09a63c30e71fc41aa1ffb694ef6e723a613e": true
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.8"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.8"
    },
    "jasmine@7.0.0": {
      "glob": "14.0.5"
    },
    "@electron/asar": {
      "glob@^13.0.2": "14.0.5",
      "minimatch@^10.0.1": "11.0.8"
    },
    "app-builder-lib@27.0.0-alpha.14": {
      "minimatch@^10.2.5": "11.0.8"
    }
  }
}
