    "globals": "^17.14.0",
    "mock-spawn": "^0.2.6",
    "prettier": "^3.10.1",
    "sinon": "22.1.0",
    "yargs": "18.2.0"
  },
  "allowScripts": {
    "github:lumine-code/keyboard-layout#c650e892b38dd2ed4ec14fd139ee2b7fcaa81d85": true,
    "github:lumine-code/fs-admin#016723a9d6d50592af45bd7040d1446b230a8a4e": true,
    "github:lumine-code/watcher#ed33d2637a140a86852661084b9099b396b0dba8": true
  },
  "overrides": {
    "eslint@^10.15.0": {
      "minimatch": "11.0.8"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.8"
    },
    "jasmine@7.0.0": {
      "glob": "14.0.6"
    },
    "@electron/asar": {
      "glob@^13.0.2": "14.0.6",
      "minimatch@^10.0.1": "11.0.8"
    },
    "app-builder-lib@27.0.0-alpha.14": {
      "minimatch@^10.2.5": "11.0.8"
    }
  }
}
