    "github:lumine-code/keyboard-layout#9bf4d7beb4ce5fcacb6b92b71cfcbc951e1d3a59": true,
    "electron-winstaller@5.4.0": true,
    "github:lumine-code/fs-admin#fc824e1ed20fdb9ce13e5e54564960e22e76e725": true,
    "github:lumine-code/watcher#62bea700b42a46de24fbb7e0bb57946a03dce5dc": true
