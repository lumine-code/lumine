  "scripts": {
    "build": "electron-rebuild",
    "start": "electron --no-sandbox --enable-logging . -f --dev",
    "dist": "node script/electron-builder.js",
    "full": "npm install && npm run build && npm run dist",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "check:icons": "node script/check-icons.js",
    "drive": "node script/drive.js",
    "generate:branding": "electron --no-sandbox script/generate-branding.js",
    "check:branding": "electron --no-sandbox script/generate-branding.js --check",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:editor": "npm run test:only -- spec",
    "test:pkgs": "npm run test:only -- packages",
    "test:main": "npm run test:only -- --main-process spec/main-process",
    "test:only": "npm start -- --test"
