    "electron-builder": "26.18.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "mock-spawn": "^0.2.6",
    "prettier": "^3.9.10",
    "sinon": "22.1.0",
    "yargs": "18.2.0"
  },
