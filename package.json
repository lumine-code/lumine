    "electron": "45.5.0",
    "electron-builder": "27.0.0-alpha.15",
    "eslint": "^10.16.0",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-n": "^18.6.0",
    "globals": "^17.14.0",
    "mock-spawn": "^0.2.6",
    "prettier": "^3.10.1",
    "sinon": "22.1.0",
    "yargs": "18.2.0"
  },
  "allowScripts": {
    "github:lumine-code/keyboard-layout#0a3f82dfed883ee1f381f615a6747629a4687e86": true,
    "github:lumine-code/fs-admin#ea14e639ac32fe01fc5e936a4c61e8720136715a": true,
    "github:lumine-code/watcher#b79bdbf1ff598ede255a46fd529a2775fc5fc3ff": true
  },
  "overrides": {
    "eslint@^10.16.0": {
      "minimatch": "11.0.9"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.9"
    },
    "jasmine@7.0.0": {
      "glob": "14.0.6"
    },
    "@electron/asar": {
      "glob@^13.0.2": "14.0.6",
      "minimatch@^10.0.1": "11.0.9"
    },
    "app-builder-lib@27.0.0-alpha.15": {
      "minimatch@^10.2.5": "11.0.9"
    }
  }
}
