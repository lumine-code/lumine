  "scripts": {
    "build": "electron-rebuild",
    "benchmark:display": "node script/benchmark-display.js",
    "benchmark:injection-routing": "node script/benchmark-injection-routing.js",
    "benchmark:presentation": "node script/benchmark-presentation.js",
    "benchmark:git": "npm run test:only -- benchmark/git-renderer-boundary-spec.js",
    "benchmark:git-refs": "node benchmark/git-refs-provider-benchmark.js",
    "benchmark:icons": "node script/benchmark-icons.js",
    "benchmark:text-editor-long-lines": "npm run test:only -- benchmark/text-editor-long-line-input-spec.js",
    "benchmark:text-editor-scroll": "npm run test:only -- benchmark/text-editor-scroll-spec.js",
    "benchmark:grammar-query-locality": "npm run test:only -- benchmark/tree-sitter-query-locality-spec.js",
    "benchmark:tree-sitter": "npm run test:only -- benchmark/tree-sitter-spec.js",
    "start": "electron --no-sandbox --enable-logging . -f --dev",
    "dist": "node script/electron-builder.js",
    "full": "npm install && npm run build && npm run dist",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "check:icons": "node script/check-icons.js",
    "generate:theme-variables": "node script/generate-theme-variables.js",
    "check:theme-variables": "node script/generate-theme-variables.js --check",
    "check:editors": "node script/check-editors.js",
    "check:grammar-captures": "node script/check-grammar-captures.js",
    "check:bundled-deps": "node script/check-bundled-deps.js",
    "check:commands": "node script/check-commands.js",
    "check:api-docs": "node script/check-api-docs.js",
    "drive": "node script/drive.js",
    "generate:branding": "electron --no-sandbox script/generate-branding.js",
    "check:branding": "electron --no-sandbox script/generate-branding.js --check",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "npm run test:document-core && npm run test:tree-sitter-runtime && npm run test:editor && npm run test:main && npm run test:launchers",
    "test:document-core": "node --test spec/main-process/document-core.test.js spec/main-process/text-store.test.js spec/main-process/text-patch.test.js spec/main-process/marker-index.test.js spec/main-process/completion-matcher.test.js spec/main-process/word-index.test.js spec/main-process/text-model-boundary.test.js",
    "test:tree-sitter-runtime": "node --test spec/main-process/tree-sitter-*.test.js spec/main-process/syntax-worker-*.test.js",
    "test:editor": "npm run test:only -- spec",
    "test:main": "npm run test:only -- --main-process spec/main-process",
    "test:launchers": "node --test script/posix-launcher.test.js script/windows-launcher.test.js script/windows-shell-uninstall.test.js",
    "test:only": "npm start -- --test",
    "test:api-extractor": "node --test script/api-extractor.test.js script/api-doc-examples.test.js script/api-doc-contracts.test.js",
    "test:eslint-jsx": "node --test script/eslint-jsx.test.js",
    "test:storage": "node --test script/package-storage.test.js script/select-list-recents.test.js",
    "benchmark:file-watch": "node benchmark/file-watch-benchmark.js",
    "benchmark:tree-sitter-editing": "npm run test:only -- benchmark/tree-sitter-editing-spec.js",
    "benchmark:text-model": "node --expose-gc benchmark/text-model-benchmark.js",
    "benchmark:text-model-renderer": "npm run test:only -- benchmark/text-model-renderer-spec.js"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.8",
    "@electron/asar": "4.3.1",
    "@electron/notarize": "^3.1.2",
    "@electron/rebuild": "4.2.1",
    "@eslint/js": "^10.0.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "mock-spawn": "^0.2.6",
    "prettier": "^3.9.10",
    "sinon": "22.1.0",
    "yargs": "18.2.0"
  },
  "allowScripts": {
    "github:lumine-code/keyboard-layout#ba321bd96abbbe4cb49e3a99effb4172bcd1aaea": true,
    "electron-winstaller@5.4.0": true,
