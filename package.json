    "eslint-plugin-n": "^18.6.0",
    "globals": "^17.14.0",
    "mock-spawn": "^0.2.6",
    "prettier": "^3.10.1",
    "sinon": "22.1.0",
    "yargs": "18.2.0"
  },
  "allowScripts": {
    "github:lumine-code/keyboard-layout#94cacd1fd758f0290bb6909450b2f231d2099e7d": true,
    "github:lumine-code/fs-admin#3a5b4b8981f1359a02f2da4059b758b75d7b7e9b": true,
    "github:lumine-code/watcher#29751ee5bd71018a25af8715c4acaeb82a9f9ef3": true
  },
  "overrides": {
    "eslint@^10.16.0": {
      "minimatch": "11.0.9"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.9"
    },
    "jasmine@7.0.0": {
      "glob": "14.0.6"
    },
    "@electron/asar": {
      "glob@^13.0.2": "14.0.6",
      "minimatch@^10.0.1": "11.0.9"
    },
    "app-builder-lib@27.0.0-alpha.15": {
      "minimatch@^10.2.5": "11.0.9"
    }
  }
}
