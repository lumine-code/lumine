    "electron": "45.2.3",
    "electron-builder": "27.0.0-alpha.14",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "mock-spawn": "^0.2.6",
    "prettier": "^3.9.10",
    "sinon": "22.1.0",
    "yargs": "18.2.0"
  },
  "allowScripts": {
    "github:lumine-code/keyboard-layout#6d91abdde29ccfe4d3db9e324b38cd3200c70b51": true,
    "github:lumine-code/fs-admin#95cdfc700fa5046de4bc709116675df2c8d635e7": true,
    "github:lumine-code/watcher#56ff427508890708f55c689bebb4761b65c99831": true
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.5"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.5"
    },
    "jasmine@7.0.0": {
      "glob": "14.0.4"
    },
    "@electron/asar": {
      "glob@^13.0.2": "14.0.4",
      "minimatch@^10.0.1": "11.0.5"
    },
    "app-builder-lib@27.0.0-alpha.14": {
      "minimatch@^10.2.5": "11.0.5"
    }
  }
}
