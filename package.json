    "github:lumine-code/keyboard-layout#be8db51aea6ec64103febbfc6deb0f93a17a1a39": true,
    "github:lumine-code/fs-admin#6dbf5213c4420dbc43127e1bb0899dbdc38b1690": true,
    "github:lumine-code/watcher#b79bdbf1ff598ede255a46fd529a2775fc5fc3ff": true
  },
  "overrides": {
    "eslint@^10.15.0": {
      "minimatch": "11.0.9"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.9"
    },
    "jasmine@7.0.0": {
      "glob": "14.0.6"
    },
    "@electron/asar": {
      "glob@^13.0.2": "14.0.6",
      "minimatch@^10.0.1": "11.0.9"
    },
    "app-builder-lib@27.0.0-alpha.15": {
      "minimatch@^10.2.5": "11.0.9"
    }
  }
}
