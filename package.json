    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "mock-spawn": "^0.2.6",
    "prettier": "^3.10.1",
    "sinon": "22.1.0",
    "yargs": "18.2.0"
  },
  "allowScripts": {
    "github:lumine-code/keyboard-layout#bc7e47f99fbf9a7c8969a6d0506cad7ef882a23f": true,
    "github:lumine-code/fs-admin#edc96b6372884d2a399e07dae0b5f3044156ba73": true,
    "github:lumine-code/watcher#b79bdbf1ff598ede255a46fd529a2775fc5fc3ff": true
  },
  "overrides": {
    "eslint@^10.15.0": {
      "minimatch": "11.0.9"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.9"
    },
    "jasmine@7.0.0": {
      "glob": "14.0.6"
    },
    "@electron/asar": {
      "glob@^13.0.2": "14.0.6",
      "minimatch@^10.0.1": "11.0.9"
    },
    "app-builder-lib@27.0.0-alpha.15": {
      "minimatch@^10.2.5": "11.0.9"
    }
  }
}
