    "electron-builder": "27.0.0-alpha.14",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "mock-spawn": "^0.2.6",
    "prettier": "^3.9.10",
    "sinon": "22.1.0",
    "yargs": "18.2.0"
  },
  "allowScripts": {
    "github:lumine-code/keyboard-layout#819a51bd01e82542699eab5a271a5b7946080277": true,
    "github:lumine-code/fs-admin#f4ae35a1e0c6d32720e9f94c744ab04c078b9bfc": true,
    "github:lumine-code/watcher#abf0dc38db2fdaeaa13ae1d8ddab65cb90e16432": true
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.4"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.4"
    },
    "jasmine@7.0.0": {
      "glob": "14.0.3"
    },
    "@electron/asar": {
      "glob@^13.0.2": "14.0.3",
      "minimatch@^10.0.1": "11.0.4"
    },
    "app-builder-lib@27.0.0-alpha.14": {
      "minimatch@^10.2.5": "11.0.4"
    }
  }
}
