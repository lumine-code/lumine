    "full": "npm install && npm run build && npm run dist",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "check:icons": "node script/check-icons.js",
    "check:editors": "node script/check-editors.js",
