    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "mock-spawn": "^0.2.6",
    "prettier": "^3.9.10",
    "sinon": "22.1.0",
    "yargs": "18.2.0"
  },
  "allowScripts": {
    "github:lumine-code/keyboard-layout#1db00de72a6c0d5b6c84c6d7983b12cadda8dace": true,
    "github:lumine-code/fs-admin#5c93038a2922e9008cbfa3520c80bcc703c8877d": true,
    "github:lumine-code/watcher#7b2484c738e17fdecc8bc2e9ef76a7b6b9f6b6ef": true
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.4"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.4"
    },
    "jasmine@7.0.0": {
      "glob": "14.0.3"
    },
    "@electron/asar": {
      "glob@^13.0.2": "14.0.3",
      "minimatch@^10.0.1": "11.0.4"
    },
    "app-builder-lib@27.0.0-alpha.14": {
      "minimatch@^10.2.5": "11.0.4"
    }
  }
}
