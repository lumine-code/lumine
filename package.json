    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "mock-spawn": "^0.2.6",
    "prettier": "^3.9.10",
    "sinon": "22.1.0",
    "yargs": "18.2.0"
  },
  "allowScripts": {
    "github:lumine-code/keyboard-layout#24743b2feb5b044463f9fec20edd9cf5fd5371da": true,
    "electron-winstaller@5.4.0": true,
    "github:lumine-code/fs-admin#f213955c7799a555d9c252294e5bf3f38531f3ff": true,
    "github:lumine-code/watcher#62bea700b42a46de24fbb7e0bb57946a03dce5dc": true
