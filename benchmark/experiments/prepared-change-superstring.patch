+Napi::Value TextBufferWrapper::prepare_change(const CallbackInfo &info) {
+  auto env = info.Env();
+  auto range = RangeWrapper::range_from_js(info[0]);
+  if (!range) return env.Undefined();
+  auto string = string_conversion::string_from_js(info[1]);
+  if (!string) return env.Undefined();
+  Point start = text_buffer.clip_position(range->start).position;
+  Point end = text_buffer.clip_position(range->end).position;
+  if (end < start) {
+    RangeError::New(env, "prepareChange expects an ordered range").ThrowAsJavaScriptException();
+    return env.Undefined();
+  }
+  Text old_text{text_buffer.text_in_range(Range{start, end})};
+  Text new_text{move(*string)};
+  Point new_extent = new_text.extent();
+  Object result = Object::New(env);
+  result.Set("oldStart", PointWrapper::from_point(env, start));
+  result.Set("oldEnd", PointWrapper::from_point(env, end));
+  result.Set("newStart", PointWrapper::from_point(env, start));
+  result.Set("newEnd", PointWrapper::from_point(env, start.traverse(new_extent)));
+  result.Set("oldText", string_conversion::string_to_js(env, old_text.content));
+  result.Set("newText", info[1]);
+  if (env.IsExceptionPending()) return env.Undefined();
+  Patch patch;
+  if (!patch.splice(start, end.traversal(start), new_extent, move(old_text), move(new_text))) {
+    Error::New(env, "Prepared patch does not apply").ThrowAsJavaScriptException();
+    return env.Undefined();
+  }
+  result.Set("patch", PatchWrapper::from_patch(env, move(patch)));
+  return result;
+}
