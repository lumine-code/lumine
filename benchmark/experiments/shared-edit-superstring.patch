+Napi::Value TextBufferWrapper::prepare_change(const CallbackInfo &info) {
+  auto env = info.Env();
+  auto range = RangeWrapper::range_from_js(info[0]);
+  if (!range) return env.Undefined();
+  auto string = string_conversion::string_from_js(info[1]);
+  if (!string) return env.Undefined();
+  Point start = text_buffer.clip_position(range->start).position;
+  Point end = text_buffer.clip_position(range->end).position;
+  if (end < start) {
+    RangeError::New(env, "prepareChange expects an ordered range").ThrowAsJavaScriptException();
+    return env.Undefined();
+  }
+  auto old_text = std::make_shared<const Text>(text_buffer.text_in_range({start, end}));
+  auto new_text = std::make_shared<const Text>(move(*string));
+  Object result = Object::New(env);
+  result.Set("oldStart", PointWrapper::from_point(env, start));
+  result.Set("oldEnd", PointWrapper::from_point(env, end));
+  result.Set("newStart", PointWrapper::from_point(env, start));
+  result.Set("newEnd", PointWrapper::from_point(env, start.traverse(new_text->extent())));
+  result.Set("oldText", string_conversion::string_to_js(env, old_text->content));
+  result.Set("newText", info[1]);
+  if (env.IsExceptionPending()) return env.Undefined();
+  Patch patch;
+  if (!patch.splice_shared(start, end.traversal(start), new_text->extent(), old_text, new_text)) {
+    Error::New(env, "Prepared patch does not apply").ThrowAsJavaScriptException();
+    return env.Undefined();
+  }
+  result.Set("patch", PatchWrapper::from_patch(env, move(patch)));
+  // A callable owns the buffer and the immutable input until commit or GC.
+  // A stale/consumed edit returns false without mutating anything.
+  struct Prepared {
+    ObjectReference owner;
+    Patch::SharedText text;
+    uint64_t revision;
+  };
+  auto prepared = std::make_shared<Prepared>();
+  prepared->owner = Persistent(info.This().As<Object>());
+  prepared->text = move(new_text);
+  prepared->revision = text_buffer.revision();
+  result.Set("apply", Function::New(env, [this, prepared, start, end](const CallbackInfo &call) {
+    if (!prepared->text || prepared->revision != text_buffer.revision()) {
+      prepared->text.reset();
+      prepared->owner.Reset();
+      return Boolean::New(call.Env(), false);
+    }
+    cancel_queued_workers();
+    auto text = move(prepared->text);
+    if (start == Point() && end == text_buffer.extent()) {
+      text_buffer.set_shared_text(move(text));
+    } else {
+      text_buffer.set_shared_text_in_range({start, end}, move(text));
+    }
+    prepared->owner.Reset();
+    return Boolean::New(call.Env(), true);
+  }));
+  return result;
+}
