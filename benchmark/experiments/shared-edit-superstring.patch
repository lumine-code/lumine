diff --git a/test/native/shared-edit-test.cc b/test/native/shared-edit-test.cc
new file mode 100644
index 0000000..3db9721
--- /dev/null
+++ b/test/native/shared-edit-test.cc
@@ -0,0 +1,47 @@
+#include "test-helpers.h"
+#include "text-buffer.h"
+#include "text-slice.h"
+
+TEST_CASE("Shared edits reuse immutable text through buffer and history") {
+  auto old_text = std::make_shared<const Text>(u"");
+  auto new_text = std::make_shared<const Text>(u"inserted\ntext");
+  std::weak_ptr<const Text> lifetime = new_text;
+  {
+    TextBuffer buffer{u"prefix\nsuffix"};
+    std::unique_ptr<TextBuffer::Snapshot> snapshot{buffer.create_snapshot()};
+    Patch history;
+    REQUIRE(history.splice_shared(Point(1, 0), Point(), new_text->extent(), old_text, new_text));
+    buffer.set_shared_text_in_range({Point(1, 0), Point(1, 0)}, new_text);
+    auto copied = history.copy();
+    auto inverted = history.invert();
+    Patch composed;
+    REQUIRE(composed.combine(history));
+    REQUIRE(history.get_changes()[0].new_text.get() == new_text.get());
+    REQUIRE(copied.get_changes()[0].new_text.get() == new_text.get());
+    REQUIRE(inverted.get_changes()[0].old_text.get() == new_text.get());
+    REQUIRE(composed.get_changes()[0].new_text.get() == new_text.get());
+    bool buffer_shares_input = false;
+    for (auto chunk : buffer.chunks()) {
+      if (chunk.text == new_text.get()) buffer_shares_input = true;
+    }
+    REQUIRE(buffer_shares_input);
+    buffer.set_text_in_range({Point(1, 0), Point(1, 1)}, u"X");
+    REQUIRE(snapshot->text() == u"prefix\nsuffix");
+    REQUIRE(copied.get_changes()[0].new_text->content == u"inserted\ntext");
+    REQUIRE(new_text->content == u"inserted\ntext");
+    new_text.reset();
+    REQUIRE_FALSE(lifetime.expired());
+  }
+  REQUIRE(lifetime.expired());
+}
+
+TEST_CASE("Shared patch splice_old creates independent concatenated text") {
+  Patch patch;
+  REQUIRE(patch.splice(Point(0, 1), Point(0, 1), Point(0, 1), Text{u"b"}, Text{u"B"}));
+  REQUIRE(patch.splice(Point(0, 3), Point(0, 1), Point(0, 1), Text{u"d"}, Text{u"D"}));
+  auto copied = patch.copy();
+  patch.splice_old(Point(0, 2), Point(0, 1), Point());
+  REQUIRE(copied.get_changes().size() == 2);
+  REQUIRE(copied.get_changes()[0].new_text->content == u"B");
+  REQUIRE(copied.get_changes()[1].new_text->content == u"D");
+}
diff --git a/test/js/prepared-change.test.js b/test/js/prepared-change.test.js
new file mode 100644
index 0000000..163d6e1
--- /dev/null
+++ b/test/js/prepared-change.test.js
@@ -0,0 +1,88 @@
+const assert = require('node:assert/strict')
+const {TextBuffer, Patch} = require('../..')
+const range = (start, end = start) => ({start, end})
+const point = (row, column) => ({row, column})
+
+describe('Shared prepared edits (experiment)', () => {
+  it('prepares without mutation and applies only once', () => {
+    const buffer = new TextBuffer('before\nlast')
+    const edit = buffer.prepareChange(range(point(0, 1), point(0, 4)), 'Ω🚀\r\nx')
+    assert.equal(buffer.getText(), 'before\nlast')
+    assert.equal(edit.oldText, 'efo')
+    assert.equal(edit.newText, 'Ω🚀\r\nx')
+    assert.equal(edit.apply(), true)
+    assert.equal(edit.apply(), false)
+    assert.equal(buffer.getText(), 'bΩ🚀\r\nxre\nlast')
+    assert.equal(edit.patch.getChanges()[0].oldText, 'efo')
+    assert.equal(edit.patch.invert().getChanges()[0].oldText, 'Ω🚀\r\nx')
+  })
+
+  for (const mutation of ['setText', 'setTextInRange', 'reset']) {
+    it(`rejects a prepared edit invalidated by ${mutation}`, () => {
+      const buffer = new TextBuffer('old')
+      const edit = buffer.prepareChange(range(point(0, 0)), 'new')
+      if (mutation === 'setTextInRange') buffer[mutation](range(point(0, 0)), 'changed')
+      else buffer[mutation]('changed')
+      const expected = buffer.getText()
+      assert.equal(edit.apply(), false)
+      assert.equal(edit.apply(), false)
+      assert.equal(buffer.getText(), expected)
+    })
+  }
+
+  it('keeps snapshots, copied history and serialization independent of later edits', () => {
+    const buffer = new TextBuffer('first\nlast')
+    const snapshot = buffer.getSnapshot()
+    const edit = buffer.prepareChange(range(point(0, 0), point(1, 4)), 'replacement\nend')
+    const copied = edit.patch.copy()
+    const inverted = copied.invert()
+    const encoded = copied.serialize()
+    assert.equal(edit.apply(), true)
+    buffer.setTextInRange(range(point(0, 2)), '!')
+    edit.patch.splice(point(0, 0), point(0, 1), point(0, 1), 'r', 'R')
+    snapshot.destroy()
+    assert.equal(copied.getChanges()[0].newText, 'replacement\nend')
+    assert.equal(inverted.getChanges()[0].oldText, 'replacement\nend')
+    assert.deepEqual(Patch.deserialize(encoded).getChanges(), copied.getChanges())
+  })
+
+  it('does not permit mutation of the history patch to alter prepared text', () => {
+    const buffer = new TextBuffer('abc')
+    const edit = buffer.prepareChange(range(point(0, 1)), 'xyz')
+    edit.patch.splice(point(0, 1), point(0, 3), point(0, 1), 'xyz', 'Q')
+    assert.equal(edit.apply(), true)
+    assert.equal(buffer.getText(), 'axyzbc')
+    assert.equal(edit.patch.getChanges()[0].newText, 'Q')
+  })
+
+  it('clips ranges and retains normalized native coordinates', () => {
+    const buffer = new TextBuffer('a\r\nb')
+    const edit = buffer.prepareChange(range(point(0, 999), point(999, 999)), '\ud800\n')
+    assert.deepEqual(edit.oldStart, point(0, 1))
+    assert.deepEqual(edit.oldEnd, point(1, 1))
+    assert.equal(edit.apply(), true)
+    assert.equal(buffer.getText(), 'a\ud800\n')
+  })
+
+  it('preserves no-op behavior', () => {
+    const buffer = new TextBuffer('abc')
+    const edit = buffer.prepareChange(range(point(0, 1)), '')
+    assert.equal(edit.patch.getChangeCount(), 0)
+    assert.equal(edit.apply(), true)
+    assert.equal(buffer.getText(), 'abc')
+  })
+
+  it('owns its input across collection and releases a consumed closure safely', () => {
+    let buffer = new TextBuffer('abc')
+    let edit = buffer.prepareChange(range(point(0, 1)), 'X'.repeat(100000))
+    const apply = edit.apply
+    const history = edit.patch.copy()
+    buffer = null
+    edit = null
+    if (global.gc) global.gc()
+    assert.equal(apply(), true)
+    if (global.gc) global.gc()
+    assert.equal(apply(), false)
+    assert.equal(history.getChanges()[0].newText.length, 100000)
+  })
+})
